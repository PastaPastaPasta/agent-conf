#!/usr/bin/env python3
"""Keep agent setup (skills, instructions, Claude agents/commands/scripts, OpenCode agents/commands) the same on every
machine that runs agents, with an optional private overlay repo (private hosts/skills) and optional private memory repo.
Python 3.9+, stdlib only.

  agent-config setup --host NAME [--overlay-repo URL] [--memory-repo URL]
                                   first run on a machine: record config, schedule, sync
  agent-config sync                update live/overlay copies, merge memory if configured, apply everything
  agent-config status              last result and recent memory conflicts (exit 1 if unhealthy)

Places on each machine:
  ~/workspace/agent-conf                 where people and agents edit shared config/skills (ordinary clone)
  ~/workspace/agent-conf-private         optional local clone of a private overlay repo (fast-forwarded if clean)
  ~/workspace/agent-memory               optional local clone of a private memory repo (fast-forwarded if clean)
  ~/.local/share/agent-config/live       owned by sync: reset to origin/main every run; links point here
  ~/.local/share/agent-config/overlay    owned by sync: clone of the private overlay repo (when configured)
  ~/.local/share/agent-config/memory     owned by sync: clone of the separate memory repo (when configured)
  ~/.claude/projects/<key>/memory        real folders; merged three-way with the memory repo's memory/<slot>

Anything this replaces or removes in the home folder goes to ~/.local/share/agent-config/backup/<time>/ first.
"""
import argparse, fcntl, hashlib, json, os, re, shutil, subprocess, sys, time, traceback
from pathlib import Path

HOME = Path(os.environ.get("AGENT_CONFIG_HOME") or Path.home())
DATA = HOME / ".local/share/agent-config"
LIVE = DATA / "live"
OVERLAY = DATA / "overlay"
MEMORY_LIVE = DATA / "memory"
MEMORY_ROOT = MEMORY_LIVE / "memory"
BASE = DATA / "memory-base"
WORK = HOME / "workspace/agent-conf"
OVERLAY_WORK = HOME / "workspace/agent-conf-private"
MEMORY_WORK = HOME / "workspace/agent-memory"
HOST_FILE = HOME / ".config/agent-config/host"
OVERLAY_REPO_FILE = HOME / ".config/agent-config/overlay-repo"
MEMORY_REPO_FILE = HOME / ".config/agent-config/memory-repo"
STATE = DATA / "state.json"
STAMP = time.strftime("%Y%m%dT%H%M%S")
SHORT_REPO = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$")
DISABLED_REPO = {"", "none", "off", "disabled"}
SKILL_DIRS = {  # harness: (skills folder, folder that must exist before we treat the harness as installed)
    "claude": (".claude/skills", ".claude"),
    "codex": (".codex/skills", ".codex"),
    "cursor": (".cursor/skills", ".cursor"),
    "gemini": (".gemini/skills", ".gemini"),
    "antigravity": (".gemini/config/skills", ".gemini/config"),
    "opencode": (".config/opencode/skills", ".config/opencode"),
}
INSTRUCTIONS = {  # dest rel: (source in instructions/, folder that must exist before we render)
    ".claude/CLAUDE.md": ("instructions/CLAUDE.md", ".claude"),
    ".codex/AGENTS.md": ("instructions/AGENTS.md", ".codex"),
    ".gemini/GEMINI.md": ("instructions/GEMINI.md", ".gemini"),
    ".cursor/rules/global-workflow.mdc": ("instructions/CURSOR.md", ".cursor"),
    ".config/opencode/AGENTS.md": ("instructions/OPENCODE.md", ".config/opencode"),
}
HEADER = ("<!-- Generated by agent-config from {src}{notes}. "
          "Edit there, commit and push; edits here are overwritten (a copy is kept). -->\n")
SECRET = re.compile(r"gh[opsu]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|(?<![A-Za-z0-9])sk-(?:ant-|proj-)?[A-Za-z0-9_-]{24,}"
                    r"|xox[abprs]-[A-Za-z0-9-]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----")
GIT_ENV = {"GIT_TERMINAL_PROMPT": "0", "GIT_HTTP_LOW_SPEED_LIMIT": "1000", "GIT_HTTP_LOW_SPEED_TIME": "60",
           "GIT_SSH_COMMAND": "ssh -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"}
MASS_DELETE = 0.5  # a machine deleting more than half of a memory folder's notes in one go is not propagated


def log(msg):
    print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}", flush=True)


def load_json(p):
    try:
        return json.loads(Path(p).read_text())
    except (OSError, ValueError):
        return {}


def manifest(name, repo=None):
    """skills.json / hosts.json. A broken manifest stops the run instead of reading as 'nothing wanted'."""
    p = (repo or LIVE) / name
    try:
        data = json.loads(p.read_text())
    except (OSError, ValueError) as e:
        raise RuntimeError(f"cannot read {p}: {e}")
    if not isinstance(data, dict) or not data:
        raise RuntimeError(f"{p} is empty or not an object")
    return data


def write_atomic(p, data):
    p = Path(p)
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.parent / f".{p.name}.{os.getpid()}.tmp"
    tmp.write_bytes(data if isinstance(data, bytes) else data.encode())
    os.replace(tmp, p)


def sha(data):
    return hashlib.sha256(data if isinstance(data, bytes) else data.encode()).hexdigest()


def git(*args, repo=LIVE, check=True, timeout=180):
    try:
        p = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, timeout=timeout,
                           encoding="utf-8", errors="replace", env={**os.environ, **GIT_ENV})
    except subprocess.TimeoutExpired:
        raise RuntimeError(f"git {' '.join(args)} timed out in {repo}")
    if check and p.returncode:
        raise RuntimeError(f"git {' '.join(args)} in {repo}: {(p.stderr or p.stdout).strip()[-600:]}")
    return p


def host_name():
    try:
        return HOST_FILE.read_text().strip()
    except OSError:
        sys.exit("this machine has no agent-config host name yet; run: agent-config setup --host NAME")


def host_conf(name, repo=LIVE):
    hosts = merged_manifest("hosts.json", repo)
    if name not in hosts:
        raise RuntimeError(f"host {name!r} is not in hosts.json ({', '.join(hosts)})")
    return hosts[name]


def overlay_repo_url():
    if not OVERLAY_REPO_FILE.exists():
        return None
    return parse_repo_spec(OVERLAY_REPO_FILE.read_text())


def overlay_active():
    return bool(overlay_repo_url()) and (OVERLAY / ".git").exists()


def merged_manifest(name, repo=LIVE):
    data = dict(manifest(name, repo))
    if overlay_active() and (OVERLAY / name).exists():
        data.update(manifest(name, OVERLAY))
    return data


def backup(path):
    """Move something we're about to replace into the backup folder; returns where it went."""
    dest = DATA / "backup" / STAMP / Path(path).relative_to(HOME)
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(path), str(dest))
    return dest


# ---------------------------------------------------------------------------------------------- live copy

def update_live(host, problems):
    """Make LIVE exactly origin/main. Edits someone made in it are saved as a patch, never lost."""
    if not (LIVE / ".git").exists():
        url = git("remote", "get-url", "origin", repo=WORK).stdout.strip()
        LIVE.parent.mkdir(parents=True, exist_ok=True)
        git("clone", "-q", url, str(LIVE), repo=LIVE.parent)
    if git("status", "--porcelain", "-uno").stdout.strip():
        write_atomic(DATA / "live-edits" / f"{STAMP}.patch", git("diff", "HEAD").stdout)
    report_live_edits(problems)
    git("fetch", "-q", "origin", "main")
    reset_live()


def reset_live():
    git("reset", "-q", "--hard", "origin/main")


def update_overlay(state, problems):
    """Make OVERLAY exactly origin/main when an overlay repo is configured; clear state when disabled."""
    ov_url = overlay_repo_url()
    if not ov_url:
        for k in ("overlay_repo", "overlay_head"):
            state.pop(k, None)
        return
    new_id = repo_identity(ov_url)
    cur_url = (git("remote", "get-url", "origin", repo=OVERLAY, check=False).stdout.strip()
               if (OVERLAY / ".git").exists() else None)
    if (state.get("overlay_repo") and repo_identity(state["overlay_repo"]) != new_id) or \
            (cur_url and repo_identity(cur_url) != new_id):
        shutil.rmtree(OVERLAY, ignore_errors=True)
    if not (OVERLAY / ".git").exists():
        if OVERLAY.exists():
            shutil.rmtree(OVERLAY)
        OVERLAY.parent.mkdir(parents=True, exist_ok=True)
        git("clone", "-q", ov_url, str(OVERLAY), repo=OVERLAY.parent)
    elif cur_url != ov_url:
        git("remote", "set-url", "origin", ov_url, repo=OVERLAY)
    if git("status", "--porcelain", "-uno", repo=OVERLAY).stdout.strip():
        write_atomic(DATA / "live-edits" / f"{STAMP}-overlay.patch", git("diff", "HEAD", repo=OVERLAY).stdout)
    report_live_edits(problems)
    git("fetch", "-q", "origin", "main", repo=OVERLAY)
    git("checkout", "-q", "-f", "-B", "main", "origin/main", repo=OVERLAY)
    state["overlay_repo"] = ov_url


def report_live_edits(problems):
    """Report each saved live-copy patch (from here or the scheduler's bootstrap) once."""
    seen = DATA / "live-edits" / ".reported"
    done = set(seen.read_text().split()) if seen.exists() else set()
    for patch in sorted((DATA / "live-edits").glob("*.patch")):
        if patch.name not in done:
            is_ov = patch.name.endswith("-overlay.patch")
            where, repo_hint = (OVERLAY, "~/workspace/agent-conf-private") if is_ov else (LIVE, "~/workspace/agent-conf")
            label = "overlay" if is_ov else "live"
            problems.append(f"someone edited the {label} copy ({where}); their change is saved as {patch}. "
                            f"Make it in {repo_hint} instead")
            done.add(patch.name)
    if done:
        write_atomic(seen, "\n".join(sorted(done)) + "\n")


def ff_work(repo):
    if not (repo / ".git").exists():
        return
    if (repo / ".githooks").is_dir() and not git("config", "core.hooksPath", repo=repo, check=False).stdout.strip():
        git("config", "core.hooksPath", ".githooks", repo=repo)
    if git("rev-parse", "--abbrev-ref", "HEAD", repo=repo).stdout.strip() != "main" or \
            git("status", "--porcelain", "-uno", repo=repo).stdout.strip():
        return
    git("fetch", "-q", "origin", "main", repo=repo, check=False)
    git("merge", "-q", "--ff-only", "origin/main", repo=repo, check=False)


def update_work():
    """Fast-forward the editing clones when nobody is working in them (diverged: whoever works there sorts it out)."""
    if (WORK / ".git").exists() and \
            git("config", "core.hooksPath", repo=WORK, check=False).stdout.strip().startswith(str(DATA)):
        git("config", "core.hooksPath", ".githooks", repo=WORK)  # left over from the retired laptop gate
    for repo in (WORK, OVERLAY_WORK, MEMORY_WORK):
        ff_work(repo)


# ---------------------------------------------------------------------------------------------- memory

def origin_prefix():
    """Match LIVE's (or WORK's) git transport prefix (SSH vs HTTPS) when expanding owner/repo."""
    for repo in (LIVE, WORK):
        if (repo / ".git").exists():
            url = git("remote", "get-url", "origin", repo=repo, check=False).stdout.strip()
            m = re.match(r"^(https?://[^/]+/|ssh://[^/]+/|(?:[A-Za-z0-9._-]+@)?[A-Za-z0-9._-]+:)", url)
            if m:
                return m.group(1)
    return "https://github.com/"


def parse_repo_spec(raw):
    spec = str(raw or "").strip()
    if spec.lower() in DISABLED_REPO:
        return None
    if SHORT_REPO.fullmatch(spec):
        return f"{origin_prefix()}{spec}.git"
    return os.path.expanduser(spec)


def repo_identity(url):
    """Canonical identity for a git URL so transport/spelling changes don't look like a different repo."""
    u = url.strip().rstrip("/")
    if u.startswith("file://"):
        return str(Path(os.path.expanduser(u[7:])).resolve())
    m = re.match(r"^(?:https?://|ssh://)(?:[^@/]+@)?([^/]+)/(.+)$", u) or \
        re.match(r"^(?:[^@/:]+@)?([^/:]+):(.+)$", u)
    if m:
        host, path = m.group(1).lower(), m.group(2).strip("/")
        if path.endswith(".git"):
            path = path[:-4]
        return f"{host}/{path.lower()}"
    return str(Path(os.path.expanduser(u)).resolve())


def memory_repo_url(conf):
    """Where Claude memory syncs, or None when memory sync is not configured for this machine.
    ~/.config/agent-config/memory-repo overrides hosts.json's memory_repo (empty/none/off disables)."""
    if MEMORY_REPO_FILE.exists():
        return parse_repo_spec(MEMORY_REPO_FILE.read_text())
    return parse_repo_spec(conf.get("memory_repo"))


def reset_memory_repo():
    if git("rev-parse", "-q", "--verify", "origin/main", repo=MEMORY_LIVE, check=False).returncode == 0:
        git("reset", "-q", "--hard", "origin/main", repo=MEMORY_LIVE)
    else:
        git("update-ref", "-d", "refs/heads/main", repo=MEMORY_LIVE, check=False)
        git("rm", "-rf", "--cached", "-q", "--ignore-unmatch", "--", "memory", repo=MEMORY_LIVE, check=False)
    git("clean", "-fdq", "--", "memory", repo=MEMORY_LIVE, check=False)


def prepare_memory_repo(conf, mem_url, state):
    """Clone/fetch the separate memory repo and apply host git_config. Returns True if origin/main exists."""
    new_id = repo_identity(mem_url)
    cur_url = (git("remote", "get-url", "origin", repo=MEMORY_LIVE, check=False).stdout.strip()
               if (MEMORY_LIVE / ".git").exists() else None)
    switched = ((state.get("memory_repo") and repo_identity(state["memory_repo"]) != new_id) or
                (cur_url and repo_identity(cur_url) != new_id))
    if switched:
        shutil.rmtree(MEMORY_LIVE, ignore_errors=True)
        shutil.rmtree(BASE, ignore_errors=True)
        state.pop("memory_base_commit", None)
    if not (MEMORY_LIVE / ".git").exists():
        if MEMORY_LIVE.exists():
            shutil.rmtree(MEMORY_LIVE)
        MEMORY_LIVE.parent.mkdir(parents=True, exist_ok=True)
        git("clone", "-q", mem_url, str(MEMORY_LIVE), repo=MEMORY_LIVE.parent)
    elif cur_url != mem_url:
        git("remote", "set-url", "origin", mem_url, repo=MEMORY_LIVE)
    for k, v in conf.get("git_config", {}).items():
        git("config", k, os.path.expanduser(v), repo=MEMORY_LIVE)  # every run: a re-clone must not lose laptop signing
    probe = git("ls-remote", "--exit-code", "--heads", "origin", "refs/heads/main", repo=MEMORY_LIVE, check=False)
    if probe.returncode == 0:
        git("fetch", "-q", "origin", "main", repo=MEMORY_LIVE)
        git("checkout", "-q", "-f", "-B", "main", "origin/main", repo=MEMORY_LIVE)
        git("clean", "-fdq", "--", "memory", repo=MEMORY_LIVE, check=False)
        return True
    if probe.returncode == 2:
        git("update-ref", "-d", "refs/remotes/origin/main", repo=MEMORY_LIVE, check=False)
        git("symbolic-ref", "HEAD", "refs/heads/main", repo=MEMORY_LIVE)
        reset_memory_repo()
        return False
    raise RuntimeError(f"git ls-remote origin main in {MEMORY_LIVE}: {(probe.stderr or probe.stdout).strip()[-600:]}")


def project_key(path):
    """Claude Code's ~/.claude/projects/<key> name: every non-alphanumeric character becomes '-'."""
    return re.sub(r"[^A-Za-z0-9]", "-", str(path))


def memory_slots():
    """{slot: local memory folder}: 'home', 'workspace', 'workspace-<repo>' (T3 worktrees share their repo's)."""
    home_key, ws_key = project_key(HOME), project_key(HOME / "workspace")
    projects = HOME / ".claude/projects"
    slots = {}
    for d in sorted(projects.glob("*")) if projects.is_dir() else []:
        if d.name == home_key:
            slots["home"] = d / "memory"
        elif d.name == ws_key or d.name.startswith(ws_key + "-"):
            slots["workspace" + d.name[len(ws_key):]] = d / "memory"
    for slot_dir in sorted(MEMORY_ROOT.glob("*")) if MEMORY_ROOT.is_dir() else []:
        slot = slot_dir.name
        if slot not in ("home", "workspace") and not slot.startswith("workspace-"):
            continue
        key = home_key if slot == "home" else ws_key + slot[len("workspace"):]
        slots.setdefault(slot, projects / key / "memory")
    return slots


def notes(folder, local=False):
    """{relative path: bytes} for memory notes (*.md) in a folder; None if the folder isn't there (unknown)."""
    if not folder.is_dir() or folder.is_symlink():
        return None
    if local:  # this machine's own folder: its symlinks are its own arrangement
        return {p.relative_to(folder).as_posix(): p.read_bytes() for p in sorted(folder.rglob("*.md"))
                if p.is_file() and not p.name.startswith(".")}
    out = {}
    for root, dirs, files in os.walk(folder):  # symlinks are skipped: a note must not read or write elsewhere
        dirs[:] = [d for d in dirs if not (Path(root) / d).is_symlink()]
        for f in files:
            p = Path(root) / f
            if f.endswith(".md") and not f.startswith(".") and p.is_file() and not p.is_symlink():
                out[p.relative_to(folder).as_posix()] = p.read_bytes()
    return dict(sorted(out.items()))


def inside(path, root):
    """path stays within root once symlinks are resolved, and root itself is a real folder."""
    return not Path(root).is_symlink() and Path(path).resolve().is_relative_to(Path(root).resolve())


ENTRY = re.compile(r"\]\(([^)]+)\)")


def index_entries(data):
    """MEMORY.md as [(key, line)]: an entry's key is its link target; other lines key on themselves."""
    out = []
    for line in (data.decode(errors="replace").splitlines() if data else []):
        m = ENTRY.search(line)
        out.append((m.group(1) if m else "\0" + line, line))
    return out


def merge_index(b, l, r, blocked=()):
    """Three-way merge of MEMORY.md by link target, so an entry edited on two machines stays one entry
    in its place. Both changed: the repo's line wins. Entries for notes kept back as secrets are dropped."""
    B, L, R = (dict(index_entries(x)) for x in (b, l, r))
    order = [k for k, _ in index_entries(l)] + [k for k, _ in index_entries(r) if k not in L]
    out = []
    for k in order:
        bl, ll, rl = B.get(k), L.get(k), R.get(k)
        line = ll if ll == rl else rl if ll == bl else ll if rl == bl else rl
        if line is not None and k not in blocked:
            out.append(line)
    return ("\n".join(out).strip() + "\n").encode()


class MemorySync:
    def __init__(self, host, state, problems):
        self.host, self.state, self.problems = host, state, problems
        self.conflicts = state.setdefault("conflicts", [])

    def remote_time(self, rel):
        out = git("log", "-1", "--format=%ct", "--", f"memory/{rel}", repo=MEMORY_LIVE, check=False).stdout.strip()
        return int(out) if out else 0

    def merge_file(self, slot, rel, b, l, r, local_dir):
        """Returns the merged content (None = deleted)."""
        if rel.endswith("MEMORY.md") and (l is None or r is None):
            return l if r is None else r  # a missing index is never a reason to empty the other side's
        if l == r:
            return l
        if l == b:
            return r
        if r == b:
            return l
        if rel.endswith("MEMORY.md"):
            return merge_index(b, l, r)
        if l is None or r is None:
            return l if r is None else r  # changed on one side, deleted on the other: keep the change
        local_newer = (local_dir / rel).stat().st_mtime >= self.remote_time(f"{slot}/{rel}")
        loser = r if local_newer else l
        note, digest = f"{slot}/{rel}", sha(loser)
        if not any(c["note"] == note and c.get("sha") == digest for c in self.conflicts):  # park each loser once
            parked = DATA / "memory-conflicts" / STAMP / slot / rel
            write_atomic(parked, loser)
            kept = "this machine" if local_newer else "the repo"
            self.conflicts.append({"at": time.time(), "note": note, "sha": digest, "kept": kept, "other_copy": str(parked)})
            self.problems.append(f"memory {note} changed on two machines; kept {kept}'s version, the other is at {parked}")
        return l if local_newer else r

    def run(self):
        """Merge every slot; write results to local folders and MEMORY_LIVE. Returns True if MEMORY_LIVE changed."""
        changed = False
        for slot, local_dir in sorted(memory_slots().items()):
            base_dir, repo_dir = BASE / slot, MEMORY_ROOT / slot
            if (repo_dir.exists() and not inside(repo_dir, MEMORY_ROOT)) or repo_dir.is_symlink():
                self.problems.append(f"memory/{slot} in the memory repo is a symlink or leads outside memory/; skipped it")
                continue
            B, L, R = notes(base_dir) or {}, notes(local_dir, local=True), notes(repo_dir) or {}
            if L is None:  # no local folder: this machine has nothing to say about the slot, so just pull
                for rel, data in R.items():
                    if not local_dir.is_symlink():
                        self.write(local_dir / rel, None, data, local=True)
                continue
            merged = {rel: self.merge_file(slot, rel, B.get(rel), L.get(rel), R.get(rel), local_dir)
                      for rel in sorted(set(B) | set(L) | set(R))}
            # A side that suddenly lost much of a folder probably didn't mean it: don't spread the deletion.
            for side, names, src in (("this machine", R, R), ("the repo", L, L)):
                gone = [rel for rel, data in merged.items() if data is None and rel in names and rel != "MEMORY.md"]
                if names and len(gone) > max(3, MASS_DELETE * len(names)):
                    self.problems.append(f"memory {slot}: {len(gone)} of {len(names)} notes were deleted by {side}; "
                                         f"kept them instead (delete them in the repo by hand if that was meant)")
                    for rel in gone:
                        merged[rel] = src[rel]
            blocked = {rel for rel, data in merged.items() if data is not None and data != R.get(rel)
                       and SECRET.search(data.decode(errors="replace"))}
            for rel in sorted(blocked):
                self.problems.append(f"memory {slot}/{rel} looks like it contains a secret; not synced until it's removed")
            for rel, data in merged.items():
                to_repo = R.get(rel) if rel in blocked else data
                if rel == "MEMORY.md" and blocked and to_repo is not None:
                    to_repo = merge_index(None, to_repo, None, blocked={b for b in blocked})
                changed |= self.write(repo_dir / rel, R.get(rel), to_repo)
                if not local_dir.is_symlink():  # someone else's arrangement; don't write through it
                    self.write(local_dir / rel, L.get(rel), data, local=True)
        return changed

    def write(self, path, old, new, local=False):
        if old == new:
            return False
        if not local and not inside(path.parent, MEMORY_ROOT):
            self.problems.append(f"{path} leads outside the memory repo's memory/; not written")
            return False
        if local and path.exists() and path.read_bytes() != old:
            return False  # an agent wrote it while we were merging; next sync picks it up
        if local and path.exists():
            dest = DATA / "backup" / STAMP / path.relative_to(HOME)  # keep what we overwrite or delete
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, dest)
        if new is None:
            if path.exists():
                path.unlink()
        else:
            write_atomic(path, new)
        return True


def save_base(state, mem_url):
    """After a successful push (or nothing to push), the memory repo's memory/ is the new common ancestor."""
    tmp, old = DATA / f"memory-base.new.{os.getpid()}", DATA / f"memory-base.old.{os.getpid()}"
    if MEMORY_ROOT.is_dir():
        shutil.copytree(MEMORY_ROOT, tmp, symlinks=True)
    else:
        tmp.mkdir(parents=True)
    if BASE.exists():
        os.replace(BASE, old)
    os.replace(tmp, BASE)
    shutil.rmtree(old, ignore_errors=True)
    state["memory_repo"] = mem_url
    state.pop("base_commit", None)  # retired: superseded by memory_base_commit once migrated
    head = git("rev-parse", "-q", "--verify", "HEAD", repo=MEMORY_LIVE, check=False)
    if head.returncode == 0:
        state["memory_base_commit"] = head.stdout.strip()
    else:
        state.pop("memory_base_commit", None)


def legacy_base_in_memory_repo(legacy_base):
    """Check whether the memory tree from an old agent-config base_commit exists in MEMORY_LIVE."""
    tree = git("rev-parse", "-q", "--verify", f"{legacy_base}:memory", repo=LIVE, check=False)
    if tree.returncode != 0:
        return False
    return git("cat-file", "-e", f"{tree.stdout.strip()}^{{tree}}", repo=MEMORY_LIVE, check=False).returncode == 0


def sync_memory(host, state, problems):
    conf = host_conf(host, repo=LIVE if (LIVE / "hosts.json").exists() else WORK)
    mem_url = memory_repo_url(conf)
    if not mem_url:
        for k in ("memory_repo", "memory_head", "memory_base_commit", "base_commit"):
            state.pop(k, None)
        return
    has_main = prepare_memory_repo(conf, mem_url, state)
    if MEMORY_ROOT.is_symlink() or (MEMORY_ROOT.exists() and not inside(MEMORY_ROOT, MEMORY_LIVE)):
        problems.append("memory/ in the memory repo is a symlink; memory sync is skipped until it's a real folder again")
        return
    base_commit = state.get("memory_base_commit")
    if base_commit and (not has_main or
                        git("merge-base", "--is-ancestor", base_commit, "origin/main", repo=MEMORY_LIVE, check=False).returncode):
        problems.append(f"memory repo origin/main no longer contains the last synced memory ({base_commit[:10]}): "
                        f"history was rewritten. Memory sync is paused here so nothing gets reverted; fix the repo, "
                        f"then delete memory_base_commit from {STATE}")
        return
    if not base_commit:
        legacy_base = state.get("base_commit")
        empty_remote = not has_main or not MEMORY_ROOT.is_dir() or not any(MEMORY_ROOT.rglob("*.md"))
        if empty_remote or (legacy_base and not legacy_base_in_memory_repo(legacy_base)):
            # Drop memory-base when the remote has no matching common ancestor so local notes are never deleted/reverted.
            shutil.rmtree(BASE, ignore_errors=True)
    try:
        for _ in range(3):
            if not MemorySync(host, state, problems).run():
                return save_base(state, mem_url)
            git("add", "--", "memory", repo=MEMORY_LIVE)
            if not git("diff", "--cached", "--quiet", repo=MEMORY_LIVE, check=False).returncode:
                return save_base(state, mem_url)
            git("-c", "core.hooksPath=/dev/null", "commit", "-q", "-m", f"chore(memory): sync from {host}",
                repo=MEMORY_LIVE)
            ours = git("rev-parse", "HEAD", repo=MEMORY_LIVE).stdout.strip()
            push = git("push", "-q", "origin", "HEAD:main", repo=MEMORY_LIVE, check=False)
            if push.returncode == 0:
                git("fetch", "-q", "origin", "main", repo=MEMORY_LIVE)
                if git("merge-base", "--is-ancestor", ours, "origin/main", repo=MEMORY_LIVE, check=False).returncode:
                    raise RuntimeError(f"memory commit {ours[:10]} is not on origin/main after a successful push; "
                                       f"something moved the memory copy during sync")
                return save_base(state, mem_url)
            if not re.search(r"fetch first|non-fast-forward|rejected", push.stderr):
                raise RuntimeError(f"memory push failed: {push.stderr.strip()[-400:]}")
            git("fetch", "-q", "origin", "main", repo=MEMORY_LIVE)  # someone pushed first: merge again on top of theirs
            reset_memory_repo()
        problems.append("memory push lost three races with other machines in a row; will retry next sync")
    finally:
        reset_memory_repo()  # never leave half-done memory in the memory copy


# ---------------------------------------------------------------------------------------------- apply

class Applier:
    def __init__(self, host, state, problems):
        self.host, self.conf, self.state, self.problems = host, host_conf(host), state, problems
        self.links = state.setdefault("links", {})  # link path -> target, for everything we created
        self.wanted = {}

    def want(self, link_path, target):
        self.wanted[str(link_path)] = str(target)

    def skills(self):
        skip = set(self.conf.get("skip_skills", []))
        ov = overlay_active()
        for name, spec in sorted(merged_manifest("skills.json").items()):
            if name in skip or (spec.get("hosts") and self.host not in spec["hosts"]):
                continue
            if "git" in spec:
                src = HOME / spec["path"]
            elif ov and (OVERLAY / "skills" / name / "SKILL.md").exists():
                src = OVERLAY / "skills" / name
            else:
                src = LIVE / "skills" / name
            if not (src / "SKILL.md").exists():
                self.problems.append(f"skill {name}: no SKILL.md at {src}")
                continue
            for harness in spec.get("targets", SKILL_DIRS):
                if harness in SKILL_DIRS:
                    skills_rel, anchor_rel = SKILL_DIRS[harness]
                    if (HOME / anchor_rel).is_dir():
                        self.want(HOME / skills_rel / name, src)

    def support_files(self):
        if (HOME / ".claude").is_dir():
            bases = [LIVE / "claude", LIVE / "hosts" / self.host / "claude"]
            if overlay_active():
                bases += [OVERLAY / "claude", OVERLAY / "hosts" / self.host / "claude"]
            for base in bases:
                for kind in ("agents", "commands", "scripts"):
                    for f in sorted((base / kind).glob("[!.]*")):
                        self.want(HOME / ".claude" / kind / f.name, f)
        if (HOME / ".config/opencode").is_dir():
            bases = [LIVE / "opencode", LIVE / "hosts" / self.host / "opencode"]
            if overlay_active():
                bases += [OVERLAY / "opencode", OVERLAY / "hosts" / self.host / "opencode"]
            for base in bases:
                for kind in ("agents", "commands"):
                    for f in sorted((base / kind).glob("[!.]*")):
                        self.want(HOME / ".config/opencode" / kind / f.name, f)

    def link_all(self):
        for link, target in sorted(self.wanted.items()):
            p = Path(link)
            if p.is_symlink() and os.readlink(p) == target:
                continue
            if p.is_symlink() or p.exists():
                backup(p)
            p.parent.mkdir(parents=True, exist_ok=True)
            p.symlink_to(target)
            log(f"linked {link}")
        for link, target in list(self.links.items()):  # uninstall what's no longer wanted
            p = Path(link)
            if link not in self.wanted and p.is_symlink() and os.readlink(p) == target:
                backup(p)
                log(f"removed {link}")
        self.links.clear()
        self.links.update(self.wanted)

    def instructions(self):
        rendered = self.state.setdefault("rendered", {})
        ov = overlay_active()
        for dest_rel, (src_rel, anchor_rel) in INSTRUCTIONS.items():
            dest = HOME / dest_rel
            if not (HOME / anchor_rel).is_dir():
                continue
            src_root = OVERLAY if (ov and (OVERLAY / src_rel).is_file()) else LIVE
            if not (src_root / src_rel).is_file():
                self.problems.append(f"{src_rel} is missing from the agent-config copy; {dest} not rendered")
                continue
            src_label = f"~/workspace/agent-conf-private/{src_rel}" if src_root == OVERLAY else f"~/workspace/agent-conf/{src_rel}"
            text = render(self.conf, (src_root / src_rel).read_text(), src_label)
            new = sha(text)
            if dest.is_symlink() or not dest.exists():
                if dest.is_symlink():
                    backup(dest)
            else:
                current = sha(dest.read_bytes())
                if current == new:
                    rendered[dest_rel] = new
                    continue
                if rendered.get(dest_rel) and current != rendered[dest_rel]:
                    saved = backup(dest)
                    self.problems.append(f"{dest} had been edited by hand; regenerated it, the edited copy is at {saved}. "
                                         f"Put the change in {src_label} if it should stay")
                else:
                    backup(dest)
            write_atomic(dest, text)
            rendered[dest_rel] = new
            log(f"rendered {dest}")

    def run(self):
        self.skills()
        self.support_files()
        self.link_all()
        self.instructions()


def render(conf, text, src_label):
    frontmatter = re.match(r"---\r?\n.*?\n---(?:\r?\n|\Z)", text, re.S)
    prefix, text = (frontmatter.group(0), text[frontmatter.end():]) if frontmatter else ("", text)
    for title in conf.get("drop_sections", []):
        text = re.sub(rf"(?ms)^## {re.escape(title)}\n.*?(?=^## |\Z)", "", text)
    for pattern, repl in conf.get("replace", []):
        text = re.sub(pattern, repl, text)
    notes_file = conf.get("notes")
    notes_label = ""
    if notes_file:
        notes_root = OVERLAY if (overlay_active() and (OVERLAY / notes_file).is_file()) else LIVE
        notes_label = (f" and ~/workspace/agent-conf-private/{notes_file}" if notes_root == OVERLAY
                       else f" and {notes_file}")
        text = (notes_root / notes_file).read_text().rstrip() + "\n\n---\n\n" + text.lstrip()
    return prefix + HEADER.format(src=src_label, notes=notes_label) + text


def externals(host, conf):
    """Clone or fast-forward skills that live in their own repos; leaves checkouts with local edits alone."""
    problems = []
    skip = set(conf.get("skip_skills", []))
    for name, spec in sorted(merged_manifest("skills.json").items()):
        if "git" not in spec or name in skip or (spec.get("hosts") and host not in spec["hosts"]):
            continue
        path = HOME / spec["path"]
        if not path.exists():
            path.parent.mkdir(parents=True, exist_ok=True)
            p = git("clone", "-q", spec["git"], str(path), repo=path.parent, check=False)
        elif not (path / ".git/index").exists():  # a --no-checkout clone (the retired laptop gate made these)
            p = git("reset", "-q", "--hard", "@{u}", repo=path, check=False)
        elif git("status", "--porcelain", "-uno", repo=path, check=False).stdout.strip():
            continue
        else:
            p = git("pull", "-q", "--ff-only", repo=path, check=False)
        if p.returncode:
            problems.append(f"skill {name}: updating {path} failed: {(p.stderr or p.stdout).strip()[-200:]}")
    return problems


# ---------------------------------------------------------------------------------------------- commands

def cmd_sync(_a):
    DATA.mkdir(parents=True, exist_ok=True)
    held = os.environ.pop("AGENT_CONFIG_LOCK_FD", None)  # the scheduler's bootstrap already holds the lock
    with (os.fdopen(int(held), "w") if held else open(DATA / "sync.lock", "w")) as lk:
        if not held:
            try:
                fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                log("another sync is running; try again in a minute")
                return 75
        host, state, problems = host_name(), load_json(STATE), []
        for k in ("approved", "trusted_commit", "external_trusted"):  # left over from the retired laptop gate
            state.pop(k, None)
        for step in (lambda: update_live(host, problems), lambda: update_overlay(state, problems),
                     lambda: sync_memory(host, state, problems),
                     lambda: problems.extend(externals(host, host_conf(host))),
                     lambda: Applier(host, state, problems).run(), update_work, lambda: check_bootstrap(host, problems)):
            try:
                step()
            except Exception as e:  # one broken step must not stop the others or hide the failure
                problems.append(f"{type(e).__name__}: {e}")
                log(traceback.format_exc().strip())
        return finish(state, problems)


def check_bootstrap(host, problems):
    """The scheduler's bootstrap is a copy that never updates itself."""
    runner, want = DATA / "run-sync", LIVE / "scheduler/run-sync"
    if runner.exists() and want.exists() and runner.read_bytes() != want.read_bytes():
        problems.append(f"{runner} is out of date; rerun: ~/workspace/agent-conf/bin/agent-config setup --host {host}")


def finish(state, problems):
    was_ok = not state.get("problems")
    head = git("rev-parse", "--short", "HEAD", check=False).stdout.strip()
    ov_head = (git("rev-parse", "--short", "HEAD", repo=OVERLAY, check=False).stdout.strip()
               if state.get("overlay_repo") and (OVERLAY / ".git").exists() else "")
    mem_head = (git("rev-parse", "--short", "HEAD", repo=MEMORY_LIVE, check=False).stdout.strip()
                if state.get("memory_repo") and (MEMORY_LIVE / ".git").exists() else "")
    week_ago = time.time() - 7 * 86400
    state["conflicts"] = [c for c in state.get("conflicts", []) if c["at"] > week_ago]
    state.update(last_sync=time.time(), head=head, problems=problems, host=HOST_FILE.read_text().strip())
    for k, val in (("overlay_head", ov_head), ("memory_head", mem_head)):
        if val:
            state[k] = val
        else:
            state.pop(k, None)
    if not problems:
        state["last_ok"] = time.time()
    write_atomic(STATE, json.dumps(state, indent=1, sort_keys=True) + "\n")
    for p in problems:
        log(f"PROBLEM: {p}")
    log(f"done at {head} ({'ok' if not problems else f'{len(problems)} problem(s)'})")
    if problems and was_ok and sys.platform == "darwin" and not os.environ.get("AGENT_CONFIG_HOME"):
        msg = problems[0][:180].replace("\\", "/").replace('"', "'")
        subprocess.run(["osascript", "-e", f'display notification "{msg}" with title "agent-config sync"'], capture_output=True)
    return 1 if problems else 0


def cmd_status(_a):
    st = load_json(STATE)
    now = time.time()
    out = {"host": st.get("host"), "head": st.get("head"), "live": str(LIVE),
           "overlay_repo": st.get("overlay_repo"), "overlay_head": st.get("overlay_head"),
           "memory_repo": st.get("memory_repo"), "memory_head": st.get("memory_head"),
           "last_sync_minutes_ago": round((now - st["last_sync"]) / 60) if st.get("last_sync") else None,
           "last_ok_minutes_ago": round((now - st["last_ok"]) / 60) if st.get("last_ok") else None,
           "problems": list(st.get("problems", [])), "memory_conflicts_last_7_days": st.get("conflicts", [])}
    if now - st.get("last_ok", 0) > 3 * 3600:  # the scheduler stopped, or every sync since has failed
        out["problems"].append("no successful sync in the last 3 hours; check the scheduler "
                               "(systemctl --user list-timers agent-config-sync.timer, or launchctl list org.pasta.agent-config-sync)")
    print(json.dumps(out, indent=1))
    return 1 if out["problems"] else 0


def cmd_setup(a):
    if a.overlay_repo is not None:
        write_atomic(OVERLAY_REPO_FILE, a.overlay_repo.strip() + "\n")
    if a.memory_repo is not None:
        write_atomic(MEMORY_REPO_FILE, a.memory_repo.strip() + "\n")
    if (WORK / ".git").exists():
        git("config", "core.hooksPath", ".githooks", repo=WORK)
        if (LIVE / ".git").exists():
            work_url = git("remote", "get-url", "origin", repo=WORK, check=False).stdout.strip()
            live_url = git("remote", "get-url", "origin", repo=LIVE, check=False).stdout.strip()
            if work_url and live_url and repo_identity(work_url) != repo_identity(live_url):
                shutil.rmtree(LIVE)
    problems, state = [], load_json(STATE)
    update_live(a.host, problems)
    update_overlay(state, problems)
    host_conf(a.host, repo=LIVE if (LIVE / "hosts.json").exists() else WORK)
    write_atomic(HOST_FILE, a.host + "\n")
    if not a.no_schedule:
        schedule()
    return cmd_sync(a)


def schedule():
    runner = DATA / "run-sync"  # outside the repo on purpose: a bad push can't break the bootstrap
    src = LIVE if (LIVE / "scheduler/run-sync").exists() else WORK
    shutil.copy(src / "scheduler/run-sync", runner)
    runner.chmod(0o755)
    if sys.platform == "darwin":
        plist = HOME / "Library/LaunchAgents/org.pasta.agent-config-sync.plist"
        tmpl = (src / "scheduler/org.pasta.agent-config-sync.plist").read_text()
        write_atomic(plist, tmpl.replace("@RUNNER@", str(runner)).replace("@HOME@", str(HOME)))
        uid = os.getuid()
        for domain in (f"gui/{uid}", f"user/{uid}"):
            subprocess.run(["launchctl", "bootout", domain, str(plist)], capture_output=True)
            if subprocess.run(["launchctl", "bootstrap", domain, str(plist)], capture_output=True).returncode == 0:
                log(f"scheduled every 15 min ({domain}, {plist})")
                return
        raise RuntimeError(f"launchctl could not load {plist}")
    unit_dir = HOME / ".config/systemd/user"
    for name in ("agent-config-sync.service", "agent-config-sync.timer"):
        write_atomic(unit_dir / name, (src / "scheduler" / name).read_text().replace("@RUNNER@", str(runner)))
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    subprocess.run(["systemctl", "--user", "enable", "--now", "agent-config-sync.timer"], check=True)
    log("scheduled every 15 min (systemd user timer agent-config-sync.timer)")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sp = sub.add_parser("setup")
    sp.add_argument("--host", required=True)
    sp.add_argument("--overlay-repo", help="git URL or owner/repo for private hosts/skills overlay ('none' to disable)")
    sp.add_argument("--memory-repo", help="git URL or owner/repo for synced Claude memory ('none' to disable)")
    sp.add_argument("--no-schedule", action="store_true")
    sub.add_parser("sync")
    sub.add_parser("status")
    a = ap.parse_args()
    sys.exit(globals()[f"cmd_{a.cmd}"](a))


if __name__ == "__main__":
    main()
