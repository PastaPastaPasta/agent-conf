#!/usr/bin/env bash
# Run the tests of every skill touched by the pushed commits, and tests/ when bin/, tests/, opencode/ or claude/scripts/ change.
set -euo pipefail
changed=""
while read -r _ local_sha _ remote_sha; do
  [[ $local_sha =~ ^0+$ ]] && continue                                       # branch deletion
  if [[ $remote_sha =~ ^0+$ ]]; then changed+=$(git ls-files)$'\n'           # new remote branch: test everything
  else changed+=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || git ls-files)$'\n'; fi
done
for m in skills.json hosts.json; do   # a broken manifest would uninstall skills everywhere
  python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert isinstance(d, dict) and d' "$m" \
    || { echo "pre-push: $m is not a valid, non-empty JSON object" >&2; exit 1; }
done
dirs=$(sed -nE 's#^skills/([^/]+)/.*#skills/\1#p' <<<"$changed" | sort -u)
grep -qE '^(bin|tests|opencode|claude/scripts)/' <<<"$changed" && dirs+=" tests"
[[ -z ${dirs// /} ]] && exit 0                                               # GNU find with no path would search .
status=0
for t in $(find $dirs -name 'test_*.py' -not -path '*/node_modules/*' 2>/dev/null); do
  echo "pre-push: $t"
  # Tests create their own repositories; inherited GIT_DIR must not redirect their git commands.
  out=$(unset $(git rev-parse --local-env-vars) && python3 -I "$t" 2>&1) || { printf '%s\n' "$out"; status=1; }
done
[[ $status -eq 0 ]] || echo "pre-push: tests failed; fix them before pushing" >&2
exit $status
